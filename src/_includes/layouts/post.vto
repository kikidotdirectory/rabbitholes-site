---
layout: layouts/base.vto
---

<main>
	<header>
		<ul class="post__metadata">
			<li>
				<time datetime="{{ date }}">{{
					date
					|> date("HUMAN_SHORT_DATE")
				}}</time>
			</li>
			<li>
				<a href="{{ link }}">{{ title }}</a> <span class="word-length"
				>({{ word_length }} words)</span>
			</li>
		</ul>
	</header>
	{{ if img_src }}
		<img src="{{ img_src }}" alt="{{ img_alt }}">
	{{ /if }}
	<h1>{{ title }}</h1>
	<p class="post__description">{{ desc }}</p>

	{{ content }}
</main>

{{ if footnotes.length }}
	{{ comp.footnotes({ footnotes }) }}
{{ /if }}
